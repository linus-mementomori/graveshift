# Nightfall — cloud layer (optional).
#
# Without these the app runs exactly as before: hosting a game is fully offline
# and account screens show a "cloud not configured" notice instead of erroring.
#
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Setup walkthrough: docs/CLOUD_PLAN.md §11
#
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time, not read at runtime.
# Whatever builds the site needs both set, and you must rebuild after changing them.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Prefer the publishable key (sb_publishable_…). The legacy `anon` key also works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# NEVER add the service_role / secret key here. It bypasses Row Level Security,
# and anything NEXT_PUBLIC_ is shipped to the browser.
