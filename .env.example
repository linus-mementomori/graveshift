
# The real domain — used for canonical URLs, the sitemap, and Open Graph tags.
# Optional: falls back to https://graveshift.1stplaybook.com if unset.
NEXT_PUBLIC_SITE_URL=https://graveshift.1stplaybook.com

# Ko-fi username — the first argument to kofiWidgetOverlay.draw().
# Optional: defaults to "1stplaybook".
NEXT_PUBLIC_KOFI_USERNAME=1stplaybook